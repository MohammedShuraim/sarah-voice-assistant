# Copy this file to ".env" and fill in your own keys.
# ".env" is git-ignored — never commit real keys.

# Required. Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Enables "what's the weather" — https://openweathermap.org/api
WEATHER_API_KEY=
DEFAULT_CITY=Hyderabad

# Optional. Enables "tell me the news" — https://newsapi.org
NEWS_API_KEY=
NEWS_COUNTRY=in

# --- Models ---
# Run "python -m sarah --check-models" to confirm these are still served.
# Groq retires models periodically: llama-3.3-70b-versatile was shut down on
# 2026-08-16 and openai/gpt-oss-120b is its recommended replacement.
CHAT_MODEL=openai/gpt-oss-120b
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# GPT-OSS models reason before they answer. Reasoning tokens come out of
# MAX_COMPLETION_TOKENS, so keep the effort low and the budget generous —
# too small a budget returns an empty reply. One of low, medium, or high.
REASONING_EFFORT=low
MAX_COMPLETION_TOKENS=1024
# Groq recommends 0.5-0.7 for these models.
TEMPERATURE=0.6

# --- Voice behaviour ---
WAKE_WORD=hey sarah
# Set to false to reply to every utterance without the wake word.
REQUIRE_WAKE_WORD=true
# Seconds of quiet that end a recording.
SILENCE_SECONDS=1.2
# Loudness below which audio counts as silence, from 0.0 to 1.0. Raise it in a
# noisy room, lower it if recordings cut off while you are still speaking.
SILENCE_THRESHOLD=0.015
MAX_RECORD_SECONDS=15
TTS_LANGUAGE=en

# --- Server ---
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173
