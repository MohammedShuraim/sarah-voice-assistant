# Copy this file to ".env" and fill in your own keys.
# ".env" is git-ignored — never commit real keys.

# Required. Free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional extras ---
# Weather commands. Free key from https://openweathermap.org/api
WEATHER_API_KEY=
DEFAULT_CITY=Hyderabad

# News headlines. Free key from https://newsapi.org
NEWS_API_KEY=
NEWS_COUNTRY=in

# --- Models ---
CHAT_MODEL=llama-3.3-70b-versatile
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Voice behaviour ---
WAKE_WORD=hey sarah
# Set to false to reply to every utterance without the wake word.
REQUIRE_WAKE_WORD=true
# Seconds of quiet that end a recording.
SILENCE_SECONDS=1.2
# Loudness below which audio counts as silence, from 0.0 to 1.0. Raise it in a
# noisy room, lower it if recordings cut off while you are still speaking.
SILENCE_THRESHOLD=0.015
MAX_RECORD_SECONDS=15
TTS_LANGUAGE=en
